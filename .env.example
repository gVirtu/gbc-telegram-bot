# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Telegram Bot Configuration
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
WEBHOOK_URL=https://your-domain.com
WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# OPTIONAL: Server Configuration
# ============================================
# PORT=8000
# LOG_LEVEL=INFO
# DEFAULT_LANGUAGE=pt-BR
# WEB_CONCURRENCY=1

# ============================================
# OPTIONAL: Chat Access Control
# Comma-separated list of allowed Telegram chat IDs
# Leave empty to allow all chats
# ============================================
# ALLOWED_CHAT_IDS=

# ============================================
# OPTIONAL: Game Configuration
# These paths are inside the container
# /app/roms is mounted from ./roms on the host
# /app/data is mounted from ./data on the host
# ============================================
# ROM_PATH=/app/roms/game.gbc
# SYM_PATH=/app/roms/game.sym
# DATA_DIR=/app/data

# ============================================
# OPTIONAL: Game Timing Settings
# ============================================
# INPUT_HOLD_FRAMES=10
# ANIMATION_DURATION=5
# SAVE_SLOTS=5
# MAX_SEQUENCE_LENGTH=6
# SEQUENCE_DELAY_SECONDS=1.0
# SEQUENCE_BUILD_TIMEOUT=10.0
# TBC_DURATION_FRAMES=10
# TBC_OVERLAY_PATH=/app/assets/to_be_continued.png

# ============================================
# OPTIONAL: Backup Settings
# ============================================
# BACKUP_HOUR=0
# BACKUP_MINUTE=0
# BACKUP_RETENTION_DAYS=30

# ============================================
# OPTIONAL: Timelapse Settings
# ============================================
# TIMELAPSE_FRAME_SKIP=20
# TIMELAPSE_BACKOFF_DELAYS=1,2,4